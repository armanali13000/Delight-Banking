rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function publicPublished() { return resource.data.accessScope == "public" && resource.data.status == "published"; }

    match /plans/{planId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /planVariants/{variantId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if publicPublished() || isAdmin();
      allow write: if isAdmin();
    }

    match /targets/{targetId} {
      allow read: if publicPublished() || isAdmin();
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if publicPublished() || isAdmin();
      allow write: if isAdmin();
    }

    match /targetProgress/{progressId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid || isAdmin();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid || isAdmin();
      allow delete: if isAdmin();
    }

    match /contentEvents/{eventId} {
      allow read, write: if false;
    }

    match /classAttendance/{attendanceId} {
      allow read, write: if false;
    }

    match /students/{studentId} {
      allow read, update: if isOwner(studentId) || isAdmin();
      allow create: if isOwner(studentId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }
    match /adminUsers/{adminUid} {
      allow read, write: if false;
    }

    match /adminActivityLogs/{logId} {
      allow read, write: if false;
    }
  }
}

